# Export these into the web and worker environments. Django does not load this file automatically.
# Local development needs no environment variables; first run manage.py init_local_settings.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=creator.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://creator.example.com
DJANGO_DB_PATH=/srv/creator/data/db.sqlite3
# Optional for integration tests: a separate, disposable file (never the live database).
# DJANGO_TEST_DB_PATH=/tmp/creator-test.sqlite3
DJANGO_MEDIA_ROOT=/srv/creator/data/media
DJANGO_STATIC_ROOT=/srv/creator/staticfiles
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_SECURE_HSTS_SECONDS=3600
# Enable these only if every subdomain is HTTPS and the domain is suitable for preload.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SMTP_HOST=smtp.example.com
DJANGO_SMTP_PORT=587
DJANGO_SMTP_USERNAME=replace-me
DJANGO_SMTP_PASSWORD=replace-me
DJANGO_SMTP_USE_TLS=true
DJANGO_SMTP_USE_SSL=false
DJANGO_SMTP_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=Creator Studio <creator@example.com>
DJANGO_SERVER_EMAIL=errors@example.com
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
FFMPEG_TIMEOUT_SECONDS=180
FFPROBE_TIMEOUT_SECONDS=15
PRODUCTION_MAX_UPLOAD_BYTES=524288000
PIPELINE_LEASE_SECONDS=30
PIPELINE_HEARTBEAT_SECONDS=5
PIPELINE_RETRY_DELAY_SECONDS=5
# AI web research (set in both server and worker environments; never commit a real key)
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-6-astra
# Optional; defaults to OPENAI_RESEARCH_MODEL when omitted.
OPENAI_REACTION_MODEL=gpt-6-astra
# Optional; defaults to OPENAI_RESEARCH_MODEL when omitted.
OPENAI_ANALYSIS_MODEL=gpt-6-astra
